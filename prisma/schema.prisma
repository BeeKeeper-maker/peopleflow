// PeopleFlow HRMS - Database Schema
// Enterprise B2B SaaS — Multi-Tenant Architecture
// PostgreSQL with JSONB support

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PLATFORM PLANE: SaaS Owner Administration
// ============================================

model PlatformAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // bcrypt hash
  name      String
  role      String    @default("platform_admin") // platform_admin, platform_super
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  impersonationSessions ImpersonationSession[]
  platformAuditLogs     PlatformAuditLog[]
  assignedSupportIssues PlatformSupportIssue[] @relation("SupportIssueAssignee")
  reportedSupportIssues PlatformSupportIssue[] @relation("SupportIssueReporter")
}

model PlatformSupportIssue {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("bug") // bug, training, feature_request, billing, device_sync, data_issue, other
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("open") // open, triaging, in_progress, waiting_on_client, resolved, closed
  scope       String   @default("core_hrms") // core_hrms, tenant_customization, paid_addon, not_aligned, unknown
  source      String   @default("platform") // platform, client_call, whatsapp, phone, email, system
  impact      String?
  nextAction  String?
  resolution  String?
  metadata    Json?
  dueAt       DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   PlatformAdmin? @relation("SupportIssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  reportedById String?
  reportedBy   PlatformAdmin? @relation("SupportIssueReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([scope])
  @@index([assignedToId])
  @@index([createdAt])
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  action     String   // tenant.suspend, tenant.activate, impersonation.start, etc.
  targetType String   // "organization", "subscription", "user"
  targetId   String   // ID of the entity acted upon
  metadata   Json?    // Arbitrary context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@index([platformAdminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ImpersonationSession {
  id     String @id @default(cuid())
  token  String @unique @default(cuid()) // Opaque session token
  reason String // Required: "Support ticket #1234"
  status String @default("active") // active, ended, expired

  // Time-boxed: auto-expires
  expiresAt DateTime // Max 1 hour from creation
  startedAt DateTime @default(now())
  endedAt   DateTime?

  // Who is being impersonated
  targetUserId         String
  targetOrganizationId String

  // Who initiated
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@index([token])
  @@index([platformAdminId])
  @@index([targetOrganizationId])
  @@index([status])
}

// ============================================
// MONETIZATION: Plans & Subscriptions
// ============================================

model Plan {
  id          String  @id @default(cuid())
  name        String  // "Starter", "Growth", "Enterprise"
  slug        String  @unique // "starter", "growth", "enterprise"
  description String?
  isActive    Boolean @default(true)

  // Pricing (in smallest currency unit — poisha/cents)
  priceMonthly Int
  priceYearly  Int
  currency     String @default("BDT")

  // Plan Limits
  maxEmployees Int // 25, 100, 500, -1 for unlimited
  maxAdmins    Int @default(3)
  maxBranches  Int @default(1)
  maxDevices   Int @default(0) // Biometric devices
  maxStorageMB Int @default(500) // File storage limit
  maxCustomRoles Int @default(0) // 0=none, -1=unlimited (Starter=0, Growth=10, Enterprise=-1)

  // Feature Flags
  features Json @default("{}")
  // { "payroll": true, "recruitment": false, "performance": false,
  //   "expenses": true, "biometric": false, "apiAccess": false,
  //   "customDocuments": false, "advancedReports": false }

  // Stripe mapping
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(cuid())
  status String @default("trialing")
  // trialing, active, past_due, canceled, suspended, expired

  billingCycle       String   @default("monthly") // monthly, yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  // Trial
  trialStart DateTime?
  trialEnd   DateTime?

  // Stripe IDs
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Overrides for enterprise custom deals
  maxEmployeesOverride Int?
  maxStorageOverride   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String       @unique // 1:1 with Organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  invoices Invoice[]

  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique // INV-2026-0001
  status        String @default("pending") // pending, paid, failed, refunded, void
  amount        Int // In smallest currency unit
  currency      String @default("BDT")
  description   String?

  // Payment tracking
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  // External IDs
  stripeInvoiceId String? @unique
  paymentMethod   String? // "card", "bank_transfer", "manual"

  // Period this invoice covers
  periodStart DateTime
  periodEnd   DateTime

  dueDate   DateTime
  createdAt DateTime @default(now())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model UsageRecord {
  id         String   @id @default(cuid())
  metric     String   // "api_calls", "storage_mb", "active_employees"
  value      Float
  recordedAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, recordedAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique // SHA-256 hash of the actual key
  keyPrefix   String    // "pk_live_xxxx" (first 8 chars, for display)
  name        String    // "Payroll Integration", "ERP Sync"
  permissions Json      // ["employees:read", "attendance:read"]
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([organizationId])
}

// ============================================
// CORE: Organizations & Users
// ============================================

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  logoUrl            String?
  industry           String?
  employeeCountRange String?
  fiscalYearStart    Int       @default(1) // Month 1-12
  countryCode        String    @default("BD")
  currencyCode       String    @default("BDT")
  timezone           String    @default("Asia/Dhaka")
  settings           Json      @default("{}") // Native JSONB
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // SaaS Fields
  status          String    @default("active") // active, suspended, deactivated
  suspendedAt     DateTime?
  suspendedReason String?
  onboardedAt     DateTime?
  trialEndsAt     DateTime?

  // Relations
  users              User[]
  departments        Department[]
  designations       Designation[]
  branches           Branch[]
  shifts             Shift[]
  employees          Employee[]
  holidayLists       HolidayList[]
  leaveTypes         LeaveType[]
  leaveEncashmentRequests LeaveEncashmentRequest[]
  salaryStructures   SalaryStructure[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  jobPostings        JobPosting[]
  candidates         Candidate[]
  applications       Application[]
  reviewCycles       ReviewCycle[]
  goals              Goal[]
  performanceReviews PerformanceReview[]
  expenseCategories  ExpenseCategory[]
  expenseClaims      ExpenseClaim[]
  approvalWorkflows  ApprovalWorkflow[]
  documentRequests   DocumentRequest[]
  biometricDevices   BiometricDevice[]
  biometricCloudEvents BiometricCloudEvent[]
  subscription       Subscription?
  usageRecords       UsageRecord[]
  apiKeys            ApiKey[]

  // Payroll v2
  festivalBonusConfigs FestivalBonusConfig[]
  lateDeductionPolicies LateDeductionPolicy[]
  pfAccounts           PFAccount[]

  // Phase 3: Approvals & RBAC
  approvalRequests      ApprovalRequest[]
  rbacPermissions       RBACPermission[]

  // Phase 4: Sync Agent
  syncApiKeys           SyncApiKey[]

  // Platform support
  supportIssues         PlatformSupportIssue[]

  // RBAC v2
  roles                 Role[]
  userRoleAssignments   UserRoleAssignment[]

  // Custom Reports
  savedReports          SavedReport[]
  scheduledReports      ScheduledReport[]

  // Custom Fields
  customFields          CustomField[]

  @@index([status])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          String    @default("employee") // admin, hr_admin, manager, employee
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Two-Factor Authentication
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Relations
  employee         Employee?
  accounts         Account[]
  sessions         Session[]
  notifications    Notification[]
  notificationPreference NotificationPreference?
  passwordHistory  PasswordHistory[]
  rbacPermissions  RBACPermission[]
  roleAssignments  UserRoleAssignment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Auth Security Tokens
// ============================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  purpose   String   @default("password_reset") // password_reset, employee_invitation, employee_reactivation
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([purpose])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PasswordHistory {
  id        String   @id @default(cuid())
  hash      String
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// Organization Setup
// ============================================

model Department {
  id          String       @id @default(cuid())
  name        String
  nameBn      String? // Bengali name
  code        String?
  description String?
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  managerId   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([organizationId, code])
}

model Designation {
  id          String   @id @default(cuid())
  name        String
  nameBn      String?
  code        String?
  grade       Int?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([organizationId, code])
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  nameBn       String?
  code         String?
  address      String?
  city         String?
  country      String   @default("Bangladesh")
  phone        String?
  email        String?
  isHeadOffice Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // GPS Geo-Fencing
  latitude       Float?   // Office latitude for geo-fence
  longitude      Float?   // Office longitude for geo-fence
  geoFenceRadius Int      @default(200) // Allowed radius in meters (default 200m)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees        Employee[]
  biometricDevices BiometricDevice[]

  @@unique([organizationId, code])
}

model Shift {
  id            String   @id @default(cuid())
  name          String
  nameBn        String?
  code          String?
  startTime     String // HH:mm format
  endTime       String
  breakDuration Int      @default(60) // minutes
  graceMinutes  Int      @default(15)
  halfDayHours  Float    @default(4)
  fullDayHours  Float    @default(8)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)

  // ── Night Shift Support ──
  // When true, the shift crosses midnight (e.g., 22:00 → 06:00).
  // The attendance date is anchored to the date the shift STARTED.
  crossesMidnight Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employees Employee[]

  @@unique([organizationId, code])
}

model HolidayList {
  id        String   @id @default(cuid())
  name      String
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  holidays Holiday[]

  @@unique([organizationId, year])
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  nameBn      String?
  date        DateTime
  description String?

  holidayListId String
  holidayList   HolidayList @relation(fields: [holidayListId], references: [id], onDelete: Cascade)
}

// ============================================
// Employee Management
// ============================================

model Employee {
  id           String @id @default(cuid())
  employeeCode String

  // Personal Info
  firstName      String
  lastName       String
  bengaliName    String?
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  gender         String? // male, female, other
  bloodGroup     String?
  maritalStatus  String? // single, married, divorced, widowed
  nationality    String    @default("Bangladeshi")
  nidNumber      String?
  passportNumber String?
  photoUrl       String?

  // Employment
  joiningDate      DateTime
  confirmationDate DateTime?
  employmentType   String    @default("permanent") // permanent, contractual, intern, probation
  employmentStatus String    @default("active") // active, resigned, terminated, retired
  deletedAt        DateTime?

  // Financial
  bankName      String?
  bankBranch    String?
  accountNumber String?
  routingNumber String?
  tinNumber     String?
  pfEnabled     Boolean @default(true)
  pfNumber      String?

  // Addresses (JSON strings)
  presentAddress   String?
  permanentAddress String?
  emergencyContact String?

  // Biometric
  biometricUserId String?  // User ID on biometric device (maps device punch → employee)

  // Custom fields
  customFields Json @default("{}") // Native JSONB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  reportingManagerId String?
  reportingManager   Employee?  @relation("ReportingHierarchy", fields: [reportingManagerId], references: [id])
  reportees          Employee[] @relation("ReportingHierarchy")

  // Employee data relations
  documents         EmployeeDocument[]
  attendances       Attendance[]
  leaveAllocations  LeaveAllocation[]
  leaveApplications LeaveApplication[]
  leaveEncashmentRequests LeaveEncashmentRequest[]
  salaryAssignments SalaryStructureAssignment[]
  salarySlips       SalarySlip[]
  loans             Loan[]

  // Payroll v2
  festivalBonusPayments FestivalBonusPayment[]
  pfAccount             PFAccount?

  // Phase 3: Approvals
  approvalRequests      ApprovalRequest[]  @relation("ApprovalRequester")
  approvalStepsActed    ApprovalStepLog[]  @relation("ApprovalActor")

  // As approver
  approvedLeaves LeaveApplication[] @relation("LeaveApprover")
  approvedLoans  Loan[]             @relation("LoanApprover")

  // Performance
  goals              Goal[]
  performanceReviews PerformanceReview[] @relation("ReviewEmployee")
  managedReviews     PerformanceReview[] @relation("ReviewManager")

  // Expenses
  expenseClaims    ExpenseClaim[] @relation("ExpenseEmployee")
  approvedExpenses ExpenseClaim[] @relation("ExpenseApprover")

  // Announcements & Documents
  announcementsAuthored Announcement[]    @relation("AnnouncementAuthor")
  documentRequests      DocumentRequest[] @relation("DocumentRequests")
  // email uniqueness handled at application level (optional field)

  @@unique([organizationId, employeeCode])
  // Performance indexes
  @@index([organizationId, employmentStatus])
  @@index([departmentId])
  @@index([designationId])
  @@index([reportingManagerId])
  @@index([deletedAt])
  // Biometric punch lookup: every punch ingestion queries by
  // (organizationId, biometricUserId). Without this index, each push
  // scans all employees in the org linearly — slow for 5000+ employees.
  @@index([organizationId, biometricUserId])
}

model EmployeeDocument {
  id             String    @id @default(cuid())
  name           String
  type           String // nid, passport, certificate, contract, etc.
  category       String    @default("other") // identity, employment, education, finance, compliance, other
  fileUrl        String
  originalName   String?
  mimeType       String?
  fileSize       Int?
  issueDate      DateTime?
  expiryDate     DateTime?
  status         String    @default("pending") // pending, verified, rejected
  isVerified     Boolean   @default(false)
  notes          String?
  tags           String[]
  uploadedById   String?
  verifiedById   String?
  verifiedAt     DateTime?
  rejectedReason String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([category])
  @@index([status])
  @@index([expiryDate])
  @@index([deletedAt])
}

// ============================================
// Leave Management
// ============================================

model LeaveType {
  id     String  @id @default(cuid())
  name   String
  nameBn String?
  code   String
  color  String  @default("#3B82F6")

  // Allocation rules
  annualAllocation  Float  @default(0)
  maxAccumulation   Float?
  carryForwardLimit Float?

  // Eligibility
  applicableGender String? // male, female, all
  minServiceDays   Int?
  requiresDocument Boolean @default(false)

  // Encashment
  encashmentAllowed Boolean @default(false)
  encashmentRate    Float   @default(100) // Percentage of basic daily rate
  proRataEnabled    Boolean @default(true)

  // Sandwich Policy
  sandwichPolicy Boolean @default(false) // Count weekends between leave days

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  allocations  LeaveAllocation[]
  applications LeaveApplication[]
  encashmentRequests LeaveEncashmentRequest[]

  @@unique([organizationId, code])
}

model LeaveAllocation {
  id             String   @id @default(cuid())
  year           Int
  allocatedDays  Float
  usedDays       Float    @default(0)
  carriedForward Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  encashmentRequests LeaveEncashmentRequest[]

  @@unique([employeeId, leaveTypeId, year])
}

// ============================================
// Leave Encashment Requests
// ============================================

/**
 * LeaveEncashmentRequest — employee request to convert unused leave into cash.
 *
 * Workflow:
 *   pending → approved → paid (included in next payroll)
 *   pending → rejected
 *
 * Calculation:
 *   encashmentAmount = encashableDays × dailyBasicRate × (encashmentRate / 100)
 *
 * Where:
 *   - encashableDays: min(requestedDays, allocation.allocatedDays - allocation.usedDays - carriedForward)
 *   - dailyBasicRate: (grossSalary / 30) — uses gross, not basic, for fairness
 *   - encashmentRate: from LeaveType.encashmentRate (default 100%)
 *
 * On approval:
 *   - LeaveAllocation.usedDays is incremented by encashableDays
 *   - The encashment amount is queued for inclusion in the next payroll run
 *     (SalarySlip.otherEarnings or a dedicated encashment line)
 */
model LeaveEncashmentRequest {
  id              String   @id @default(cuid())
  status          String   @default("pending") // pending, approved, rejected, paid
  requestedDays   Float    // Days the employee wants to encash
  encashableDays  Float    // Actual days eligible (after balance check)
  dailyBasicRate  Float    // (grossSalary / 30) at time of request
  encashmentRate  Float    // % from LeaveType.encashmentRate
  encashmentAmount Float   // final amount = encashableDays × dailyBasicRate × (rate/100)
  reason          String?  // Employee's reason for encashment
  rejectionReason String?
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedById    String?  // Employee ID of approver (HR/manager)
  paidAt          DateTime? // When included in payroll
  payrollMonth    Int?     // Month paid in
  payrollYear     Int?     // Year paid in
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  allocationId String?
  allocation   LeaveAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([organizationId])
  @@index([leaveTypeId])
}

model LeaveApplication {
  id              String    @id @default(cuid())
  fromDate        DateTime
  toDate          DateTime
  totalDays       Float
  halfDay         Boolean   @default(false)
  halfDayType     String? // first_half, second_half
  reason          String?
  status          String    @default("pending") // pending, approved, rejected, cancelled
  rejectionReason String?
  documents       Json? // JSONB array of file URLs
  appliedAt       DateTime  @default(now())
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Maternity Leave Compliance (BLA 2006, Section 46-47) ──
  // Tracks pre-delivery (8 weeks) and post-delivery (8 weeks) split
  isMaternityLeave      Boolean   @default(false)
  maternityPhase        String?   // pre_delivery, post_delivery, full (when applied as single block)
  expectedDeliveryDate  DateTime? // Employee-declared expected date of delivery
  actualDeliveryDate    DateTime? // Actual date (updated post-delivery)
  preDeliveryDays       Int?      // Days taken before delivery (max 56 = 8 weeks)
  postDeliveryDays      Int?      // Days taken after delivery (max 56 = 8 weeks)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  approverId String?
  approver   Employee? @relation("LeaveApprover", fields: [approverId], references: [id])

  // Performance indexes
  @@index([employeeId])
  @@index([status])
  @@index([approverId])
  @@index([fromDate, toDate])
}

// ============================================
// Attendance Management
// ============================================

model Attendance {
  id                String    @id @default(cuid())
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  checkInLocation   String? // JSON {lat, lng, address}
  checkOutLocation  String?
  status            String    @default("present") // present, absent, half_day, on_leave, holiday, weekend
  lateMinutes       Int       @default(0)
  earlyLeaveMinutes Int       @default(0)
  overtimeMinutes   Int       @default(0)
  source            String    @default("web") // web, mobile, biometric, manual
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  // Performance indexes
  @@index([date])
  @@index([status])
}

// ============================================
// Payroll Management
// ============================================

model SalaryStructure {
  id          String  @id @default(cuid())
  name        String
  code        String?
  description String?

  // Earnings (percentages or fixed amounts)
  basicPercentage  Float @default(50) // % of gross
  houseRentPercent Float @default(50) // % of basic
  medicalPercent   Float @default(10) // % of basic
  conveyanceFixed  Float @default(0)

  // Deductions
  pfEmployeePercent Float @default(10) // % of basic
  pfEmployerPercent Float @default(10)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments SalaryStructureAssignment[]

  @@unique([organizationId, code])
}

model SalaryStructureAssignment {
  id            String    @id @default(cuid())
  grossSalary   Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@index([employeeId])
  @@index([isActive])
}

model SalarySlip {
  id    String @id @default(cuid())
  month Int // 1-12
  year  Int

  // Working days
  totalWorkingDays Float
  presentDays      Float
  absentDays       Float @default(0)
  leaveDays        Float @default(0)

  // Earnings
  basicSalary      Float
  houseRent        Float @default(0)
  medicalAllowance Float @default(0)
  conveyance       Float @default(0)
  specialAllowance Float @default(0)
  overtime         Float @default(0)
  bonus            Float @default(0) // Legacy ad-hoc bonus
  festivalBonus    Float @default(0) // Festival bonus (Eid, Durga Puja, etc.)
  arrears          Float @default(0)
  otherEarnings    Float @default(0)
  grossSalary      Float

  // Deductions
  pfEmployee       Float @default(0)
  incomeTax        Float @default(0)
  loanDeduction    Float @default(0)
  advanceDeduction Float @default(0)
  absentDeduction  Float @default(0)
  lateDeduction    Float @default(0)
  otherDeductions  Float @default(0)
  totalDeductions  Float

  // Employer contribution
  pfEmployer Float @default(0)

  // Net
  netSalary Float

  status         String    @default("draft") // draft, approved, paid, locked
  paymentDate    DateTime?
  paymentMode    String? // bank_transfer, cash, cheque
  transactionRef String?

  // Lock: once paid, a slip is locked and cannot be re-processed.
  // Lock can only be removed via explicit unlock (with audit log).
  isLocked        Boolean   @default(false)
  lockedAt        DateTime?
  lockedById      String?   // User ID who locked
  lockedReason    String?

  // Reversal: if a paid slip needs correction, it's reversed (not deleted).
  // A new corrected slip is then re-processed.
  isReversed      Boolean   @default(false)
  reversedAt      DateTime?
  reversedById    String?
  reversedReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  // Performance indexes
  @@index([month, year])
  @@index([status])
}

// ============================================
// Loan Management
// ============================================

model Loan {
  id              String    @id @default(cuid())
  type            String // salary_advance, emergency, personal, etc.
  amount          Float
  interestRate    Float     @default(0)
  tenure          Int // months
  emiAmount       Float
  disbursedAmount Float     @default(0)
  paidAmount      Float     @default(0)
  remainingAmount Float
  status          String    @default("pending") // pending, approved, rejected, disbursed, closed
  reason          String?
  approvedAt      DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  approverId String?
  approver   Employee? @relation("LoanApprover", fields: [approverId], references: [id])

  repayments LoanRepayment[]

  @@index([employeeId])
  @@index([status])
}

model LoanRepayment {
  id            String   @id @default(cuid())
  installmentNo Int
  amount        Float
  principalPart Float
  interestPart  Float
  paidDate      DateTime
  method        String   @default("payroll") // payroll, bank_transfer, cash
  reference     String?  // Transaction reference number
  note          String?
  createdAt     DateTime @default(now())

  loanId String
  loan   Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([paidDate])
}

// ============================================
// Festival Bonus Management
// ============================================

/**
 * Organization-level festival bonus configuration.
 * Supports multiple festivals per year (Eid-ul-Fitr, Eid-ul-Adha, Durga Puja, Christmas, etc.)
 * Bangladesh reality: Most companies give 2 Eid bonuses at 50-100% of basic.
 * Some give Durga Puja (Hindu), Christmas (Christian) bonuses as well.
 */
model FestivalBonusConfig {
  id             String  @id @default(cuid())
  name           String  // "Eid-ul-Fitr Bonus 2025", "Durga Puja Bonus"
  nameBn         String? // "ঈদ-উল-ফিতর বোনাস ২০২৫"
  festivalType   String  // eid_ul_fitr, eid_ul_adha, durga_puja, christmas, new_year, custom
  year           Int

  // Calculation rules
  calculationBasis  String  @default("basic") // basic, gross
  percentageOfBasis Float   @default(100)     // 50%, 100%, 200% of basic/gross

  // Eligibility rules
  minimumServiceDays  Int     @default(180)     // Must have worked N days to be eligible (6 months)
  proRataForNewJoinee Boolean @default(true)    // Pro-rate for employees with less than 1 year service
  includeProbation    Boolean @default(false)   // Include probation-period employees
  includeContractual  Boolean @default(false)   // Include contractual employees

  // Status
  status    String   @default("draft") // draft, generated, approved, paid
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  payments FestivalBonusPayment[]

  @@unique([organizationId, festivalType, year])
  @@index([organizationId])
  @@index([year])
}

/**
 * Individual bonus payment records — one per eligible employee per festival.
 * Created in bulk by the bonus engine, paid via payroll integration.
 */
model FestivalBonusPayment {
  id                String   @id @default(cuid())
  amount            Float    // Calculated bonus amount
  basisAmount       Float    // The basic/gross used for calculation
  percentageApplied Float    // Actual % applied (may differ if pro-rated)
  proRataFactor     Float    @default(1.0)  // 1.0 = full, 0.5 = half year, etc.
  isProRated        Boolean  @default(false)
  status            String   @default("pending") // pending, included_in_payroll, paid, cancelled
  payrollMonth      Int?     // Month this bonus was included in payroll
  payrollYear       Int?     // Year this bonus was included in payroll
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  bonusConfigId String
  bonusConfig   FestivalBonusConfig @relation(fields: [bonusConfigId], references: [id], onDelete: Cascade)

  @@unique([employeeId, bonusConfigId]) // One payment per employee per festival
  @@index([employeeId])
  @@index([bonusConfigId])
  @@index([status])
}

// ============================================
// Late Deduction Policy (Tiered Severity)
// ============================================

/**
 * Organization-level late deduction policy.
 * Bangladesh corporate standard: progressive severity tiers per month.
 *
 * Example common policy:
 *   Tier 1 (1-3 lates):  Grace — no deduction
 *   Tier 2 (4-6 lates):  Warning + 0.5 day deduction per late
 *   Tier 3 (7-9 lates):  1 day deduction per late
 *   Tier 4 (10+ lates):  Full day deduction per late + written warning
 */
model LateDeductionPolicy {
  id       String  @id @default(cuid())
  name     String  // "Standard Policy", "Factory Floor Policy"
  isActive Boolean @default(true)

  // Late definition threshold (minutes after grace before counting as "late")
  lateThresholdMinutes  Int @default(0) // Additional minutes beyond shift grace

  // Monthly reset — late count resets every month
  monthlyReset Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tiers LateDeductionTier[]

  @@index([organizationId])
}

/**
 * Individual severity tier within a late deduction policy.
 * Tiers are evaluated in order — the highest matching tier applies.
 */
model LateDeductionTier {
  id        String @id @default(cuid())
  tierOrder Int    // 1, 2, 3, 4... (ascending severity)
  name      String // "Grace Period", "Warning", "Half-Day Cut", "Full-Day Cut"
  nameBn    String?

  // Trigger: this tier activates when monthly late count is >= fromCount and <= toCount
  fromCount Int // e.g., 1 (inclusive)
  toCount   Int // e.g., 3 (inclusive), use 999 for "unlimited"

  // Deduction per late in this tier
  deductionType  String @default("none") // none, half_day, full_day, fixed_amount, percentage_of_daily
  deductionValue Float  @default(0)      // For fixed_amount: BDT value. For percentage_of_daily: % (e.g., 50 = half day)

  // Administrative action
  issueWarning  Boolean @default(false) // Generate a warning notification
  warningLevel  String  @default("verbal") // verbal, written, final

  policyId String
  policy   LateDeductionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, tierOrder])
  @@index([policyId])
}

// ============================================
// Provident Fund (PF) Ledger
// ============================================

/**
 * PF Account — one per employee.
 * Tracks running balance of employee + employer contributions.
 * Bangladesh PF rules: Employee and Employer contribute equally (typically 10% of basic).
 * Interest is calculated annually and credited to the account.
 */
model PFAccount {
  id                  String   @id @default(cuid())
  accountNumber       String?  // Organization-assigned PF account number
  status              String   @default("active") // active, frozen, withdrawn, settled
  openingDate         DateTime @default(now())
  closingDate         DateTime?

  // Running balances (updated on each transaction)
  employeeBalance     Float    @default(0) // Total employee contributions
  employerBalance     Float    @default(0) // Total employer contributions
  interestBalance     Float    @default(0) // Total interest accrued
  totalBalance        Float    @default(0) // employee + employer + interest

  // Last interest calculation
  lastInterestDate    DateTime?
  interestRate        Float    @default(12.0) // Annual interest rate (BD standard: 12%)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String @unique // One PF account per employee
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  transactions PFTransaction[]

  @@index([organizationId])
  @@index([status])
}

/**
 * PF Transaction — double-entry ledger for every movement.
 *
 * Transaction types:
 *   - employee_contribution: Monthly deduction from salary
 *   - employer_contribution: Employer's matching contribution
 *   - interest_credit: Annual interest credited to account
 *   - withdrawal: Partial or full withdrawal
 *   - settlement: Final settlement on resignation/retirement
 *   - adjustment: Manual correction by HR/Finance
 */
model PFTransaction {
  id              String   @id @default(cuid())
  transactionType String   // employee_contribution, employer_contribution, interest_credit, withdrawal, settlement, adjustment
  amount          Float    // Positive for credits, negative for debits
  runningBalance  Float    // Balance AFTER this transaction
  description     String   // "March 2025 Employee Contribution", "FY2024-25 Interest @12%"
  referenceMonth  Int?     // For contributions: month (1-12)
  referenceYear   Int?     // For contributions: year
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  pfAccountId String
  pfAccount   PFAccount @relation(fields: [pfAccountId], references: [id], onDelete: Cascade)

  @@index([pfAccountId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([referenceMonth, referenceYear])
}

// ============================================
// Custom Fields Builder
// ============================================

/**
 * CustomField — admin-defined field that extends a standard entity.
 *
 * Entities supported: Employee (primary use case), Attendance, LeaveApplication.
 *
 * Field types:
 *   text: single-line string
 *   textarea: multi-line string
 *   number: numeric value
 *   date: date picker
 *   select: dropdown with predefined options
 *   boolean: yes/no toggle
 *
 * The value is stored in the entity's `customFields` JSONB column
 * (e.g., Employee.customFields = { "blood_group": "O+", "emergency_contact": "..." }).
 *
 * This table defines the FIELD SCHEMA (label, type, options, required).
 * The actual VALUES are stored per-entity in the JSONB column.
 */
model CustomField {
  id              String   @id @default(cuid())
  label           String                         // "Blood Group", "Emergency Contact"
  key             String                         // "blood_group" — used in customFields JSONB
  entityType      String                         // Employee, Attendance, LeaveApplication
  fieldType       String                         // text, textarea, number, date, select, boolean
  options         String[]                       // for select type: ["O+", "A+", "B+", "AB+", "O-", "A-", "B-", "AB-"]
  isRequired      Boolean  @default(false)
  isFilterable    Boolean  @default(false)       // show in report builder filters
  isSearchable    Boolean  @default(false)       // include in global search
  defaultValue    String?
  description     String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType])
  @@index([isActive])
}

// ============================================
// Custom Reports & Saved Views
// ============================================

/**
 * SavedReport — a user-defined custom report configuration.
 *
 * Users (HR/admin) can build custom reports by:
 *   1. Selecting a data source (employees, attendance, payroll, leave, expenses)
 *   2. Selecting fields to include
 *   3. Applying filters (date range, department, status, etc.)
 *   4. Choosing a format (table, bar chart, line chart, pie chart)
 *   5. Saving the configuration for reuse
 *
 * The report is executed on-demand by POST /api/reports/custom/[id]/run
 * or scheduled via ScheduledReport (email delivery).
 */
model SavedReport {
  id              String   @id @default(cuid())
  name            String
  description     String?
  dataSource      String   // employees, attendance, payroll, leave, expenses, loans
  fields          String[] // selected field keys: ["firstName", "lastName", "department.name"]
  filters         Json     @default("{}") // { "departmentId": "...", "status": "active", "dateFrom": "...", "dateTo": "..." }
  groupBy         String?  // optional field to group by
  chartType       String?  // table, bar, line, pie — null = table only
  isShared        Boolean  @default(false) // shared with other admins in the org

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  schedules       ScheduledReport[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([dataSource])
}

/**
 * ScheduledReport — a saved report scheduled for automatic email delivery.
 *
 * Cron: daily at 9 AM BD time, weekly on Monday 9 AM, monthly on the 1st.
 * The scheduled-report-worker picks up due schedules, runs the report,
 * generates a PDF/CSV, and emails it to the recipients.
 */
model ScheduledReport {
  id              String   @id @default(cuid())
  frequency       String   // daily, weekly, monthly
  nextRunAt       DateTime
  lastRunAt       DateTime?
  recipients      String[] // user IDs to email
  format          String   @default("pdf") // pdf, csv, xlsx
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedReportId   String
  savedReport     SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([organizationId])
  @@index([savedReportId])
}

// ============================================
// Announcements & Notifications
// ============================================

model Announcement {
  id                String    @id @default(cuid())
  title             String
  content           String
  type              String    @default("general") // general, policy, celebration, urgent
  priority          String    @default("medium") // low, medium, high, critical
  isPinned          Boolean   @default(false)
  publishDate       DateTime  @default(now())
  expiryDate        DateTime?
  targetDepartments String? // JSON array of department IDs, null = all
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authorId String?
  author   Employee? @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([publishDate])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String // leave_approval, payroll, announcement, reminder, alert, etc.
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance indexes
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * NotificationPreference — per-user control over notification channels.
 *
 * Each user can independently enable/disable:
 *   - in_app: bell icon in the dashboard
 *   - email: SMTP email
 *   - push: web push notification (PWA service worker)
 *
 * Per category (leave, payroll, attendance, etc.), so a user can get
 * email for payroll but only in-app for announcements.
 *
 * digestMode: if "instant" → each event fires immediately
 *             if "daily" → events batched into one daily summary email
 *             if "weekly" → events batched into one weekly summary
 */
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Channel toggles (global defaults)
  inAppEnabled    Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(false)

  // Digest mode
  digestMode      String   @default("instant") // instant, daily, weekly

  // Quiet hours (no push/email during these hours, BD local time)
  quietHoursStart String?  // "22:00" — null = no quiet hours
  quietHoursEnd   String?  // "07:00"

  // Per-category overrides (JSON: { "leave_approval": { "email": false }, ... })
  // If a category is not in the map, use the global defaults above.
  categoryOverrides Json?  @default("{}")

  // Push subscription endpoint (for web push)
  pushSubscription Json?   // { endpoint, keys: { p256dh, auth } }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Audit Trail
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String // create, update, delete, view
  entityType String // Employee, LeaveApplication, Attendance, etc.
  entityId   String
  oldValues  String? // JSON
  newValues  String? // JSON
  ipAddress  String?
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Performance indexes
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Recruitment / Applicant Tracking
// ============================================

model JobPosting {
  id               String  @id @default(cuid())
  title            String
  description      String
  requirements     String?
  responsibilities String?

  employmentType String // full_time, part_time, contract, internship
  experience     String? // 0-1 years, 2-5 years, 5+ years
  education      String? // required education level
  skills         String? // comma-separated skills

  salaryMin  Float?
  salaryMax  Float?
  currency   String  @default("BDT")
  showSalary Boolean @default(false)

  location String?
  isRemote Boolean @default(false)

  status   String @default("draft") // draft, open, paused, closed
  openings Int    @default(1)

  postedAt  DateTime?
  closesAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  applications Application[]
}

model Candidate {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?

  resumeUrl    String?
  portfolioUrl String?
  linkedinUrl  String?

  currentCompany String?
  currentTitle   String?
  yearsOfExp     Float?
  expectedSalary Float?
  noticePeriod   String? // immediate, 15 days, 1 month, etc.

  skills    String? // comma-separated skills
  education String?
  source    String? // linkedin, referral, website, job_board
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  applications Application[]

  @@unique([email, organizationId])
}

model Application {
  id String @id @default(cuid())

  stage  String @default("applied") // applied, screening, interview, technical, hr, offer, hired, rejected
  status String @default("pending") // pending, in_progress, passed, failed, withdrawn

  coverLetter String?
  rating      Int? // 1-5 rating
  feedback    String?

  interviewDate  DateTime?
  interviewNotes String?

  offerSalary Float?
  offerDate   DateTime?
  joinDate    DateTime?

  rejectionReason String?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobPostingId])
}

// ============================================
// Performance Management
// ============================================

model ReviewCycle {
  id          String   @id @default(cuid())
  name        String // "Q1 2026", "Annual 2026"
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("draft") // draft, active, completed
  type        String // quarterly, biannual, annual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  goals   Goal[]
  reviews PerformanceReview[]
}

model Goal {
  id          String  @id @default(cuid())
  title       String
  description String?
  type        String  @default("individual") // individual, team, company
  priority    String  @default("medium") // low, medium, high, critical
  status      String  @default("not_started") // not_started, in_progress, completed, cancelled
  progress    Int     @default(0) // 0-100

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewCycleId String?
  reviewCycle   ReviewCycle? @relation(fields: [reviewCycleId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  keyResults KeyResult[]

  // Performance indexes
  @@index([employeeId])
  @@index([status])
  @@index([reviewCycleId])
}

model KeyResult {
  id           String  @id @default(cuid())
  title        String
  targetValue  Float
  currentValue Float   @default(0)
  unit         String? // %, count, BDT, etc.
  status       String  @default("pending") // pending, on_track, at_risk, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id     String @id @default(cuid())
  status String @default("pending") // pending, self_review, manager_review, completed

  // Self assessment
  selfRating      Int? // 1-5
  selfComments    String?
  selfSubmittedAt DateTime?

  // Manager assessment  
  managerRating      Int?
  managerComments    String?
  managerSubmittedAt DateTime?

  // Overall
  overallRating Int?
  strengths     String?
  improvements  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerId String?
  reviewer   Employee? @relation("ReviewManager", fields: [reviewerId], references: [id])

  reviewCycleId String
  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, reviewCycleId])
}

// ============================================
// EXPENSE MANAGEMENT
// ============================================

model ExpenseCategory {
  id              String   @id @default(cuid())
  name            String // Travel, Meals, Software, Office Supplies, etc.
  nameBn          String? // Bengali name
  description     String?
  maxAmount       Float? // Maximum claimable amount per claim
  monthlyLimit    Float? // Monthly limit per employee
  requiresReceipt Boolean  @default(true)
  isActive        Boolean  @default(true)
  icon            String? // Icon name for UI
  color           String? // Color for UI

  // Category type: standard, mileage, per_diem
  // mileage: distance-based (e.g., fuel reimbursement per km)
  // per_diem: daily allowance (e.g., travel allowance per day)
  categoryType    String   @default("standard") // standard, mileage, per_diem

  // For mileage categories: rate per km (in BDT)
  mileageRate     Float?   // e.g., 15.0 BDT per km

  // For per-diem categories: daily rate (in BDT)
  perDiemRate     Float?   // e.g., 1500.0 BDT per day

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expenses ExpenseClaim[]

  @@unique([organizationId, name])
}

model ExpenseClaim {
  id          String @id @default(cuid())
  claimNumber String @unique // Auto-generated: EXP-2026-0001

  // Claim details
  title       String
  description String?
  amount      Float    // Original amount in the expense currency
  currency    String   @default("BDT") // ISO 4217: BDT, USD, EUR, GBP, INR, etc.
  expenseDate DateTime // Date when expense occurred

  // Multi-currency support
  // exchangeRate: 1 unit of `currency` = exchangeRate units of BDT
  // amountInBDT: amount × exchangeRate (computed at submission time)
  // If currency is BDT, exchangeRate = 1 and amountInBDT = amount
  exchangeRate  Float    @default(1.0)
  amountInBDT   Float    @default(0) // Converted amount in BDT for payroll/reports

  // Mileage tracking (for categoryType = "mileage")
  distance      Float?   // Distance in km
  distanceUnit  String?  // km, mile (default: km)
  // amount = distance × category.mileageRate (computed)

  // Per-diem tracking (for categoryType = "per_diem")
  perDiemDays   Float?   // Number of days (can be fractional: 0.5 for half day)
  perDiemRate   Float?   // Daily rate (copied from category at submission time)
  // amount = perDiemDays × perDiemRate (computed)

  // Policy violation flag (set by policy engine)
  policyViolation String? // null = no violation, or description of violation
  policyViolationType String? // over_limit, missing_receipt, duplicate, out_of_policy

  // Receipt/proof
  receiptUrl  String?
  receiptName String? // Original filename

  // Status workflow: draft -> submitted -> approved/rejected -> reimbursed
  status String @default("draft") // draft, submitted, approved, rejected, reimbursed, cancelled

  // Approval details
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  reimbursedAt  DateTime?
  approverNotes String? // Reason for approval/rejection

  // Payment details (when reimbursed)
  paymentMethod    String? // bank_transfer, cash, payroll
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  employeeId String
  employee   Employee @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  approverId String?
  approver   Employee? @relation("ExpenseApprover", fields: [approverId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([currency])
}

/**
 * ExchangeRate — cached currency exchange rates for expense conversion.
 *
 * Rates are fetched from an external API (e.g., exchangerate-api.com)
 * daily by a cron job and cached here. The expense submission flow
 * reads the latest rate for the claim's currency.
 *
 * baseCurrency: always "BDT" for PeopleFlow (Bangladesh-focused)
 * quoteCurrency: the foreign currency (USD, EUR, etc.)
 * rate: 1 quoteCurrency = rate BDT
 */
model ExchangeRate {
  id              String   @id @default(cuid())
  baseCurrency    String   @default("BDT")
  quoteCurrency   String   // USD, EUR, GBP, INR, etc.
  rate            Float    // 1 USD = rate BDT
  fetchedAt       DateTime @default(now())
  source          String?  // exchangerate-api, manual, etc.

  @@unique([baseCurrency, quoteCurrency])
  @@index([quoteCurrency])
  @@index([fetchedAt])
}

// ============================================
// Approval Workflows
// ============================================

model ApprovalWorkflow {
  id         String  @id @default(cuid())
  entityType String  // leave, expense, loan, attendance_regularize
  name       String
  steps      String  // JSON array of workflow steps
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType])
  @@index([entityType])
}

// ============================================
// Stateful Approval Engine (Phase 3)
// ============================================

/**
 * ApprovalRequest — persistent, stateful tracking for multi-level approvals.
 *
 * This is the "brain" of the approval system. Every leave, expense, loan, etc.
 * request creates an ApprovalRequest that tracks:
 *   - Current step in the workflow
 *   - Complete audit trail of who approved/rejected at each step
 *   - Timeout/escalation tracking
 *
 * Lifecycle:
 *   pending → in_progress → approved/rejected/cancelled/escalated
 */
model ApprovalRequest {
  id              String    @id @default(cuid())
  entityType      String    // leave, expense, loan, attendance_regularize, document_request
  entityId        String    // ID of the entity being approved (LeaveApplication.id, etc.)
  requestTitle    String    // "Annual Leave: 5 days (Jan 15-19)" — human-readable
  status          String    @default("pending") // pending, in_progress, approved, rejected, cancelled, escalated

  // Workflow tracking
  totalSteps      Int       // Total number of approval steps
  currentStep     Int       @default(1) // Current step number (1-indexed)
  currentApproverRole   String?   // Role required for current step
  currentApproverId     String?   // Specific person assigned for current step

  // Metadata
  priority        String    @default("normal") // low, normal, high, urgent
  dueDate         DateTime? // Auto-escalate if not actioned by this date
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  requesterId     String
  requester       Employee  @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  steps           ApprovalStepLog[]

  @@unique([entityType, entityId]) // One approval request per entity
  @@index([organizationId])
  @@index([status])
  @@index([currentApproverId])
  @@index([requesterId])
  @@index([entityType])
}

/**
 * ApprovalStepLog — individual step record in the approval chain.
 *
 * One record per step per request. Provides complete audit trail:
 *   - WHO approved/rejected
 *   - WHEN they took action
 *   - WHAT notes they left
 *   - HOW LONG it took
 *
 * Steps are created AHEAD of time (all workflow steps get seeded on request creation)
 * and then UPDATED when the actor takes action.
 */
model ApprovalStepLog {
  id              String    @id @default(cuid())
  stepNumber      Int       // 1, 2, 3... (matches workflow step order)
  stepName        String    // "Manager Approval", "HR Review", "MD Final Approval"

  // Who should approve
  assignedRole    String    // manager, hr_admin, admin, department_head, md
  assignedToId    String?   // Specific person, if pre-assigned

  // Action taken
  status          String    @default("pending") // pending, approved, rejected, skipped, escalated
  actedById       String?   // Who actually took the action
  actedBy         Employee? @relation("ApprovalActor", fields: [actedById], references: [id])
  actedAt         DateTime?
  notes           String?   // Comments from the approver
  timeToAction    Int?      // Minutes from assignment to action (SLA tracking)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@unique([approvalRequestId, stepNumber]) // One log per step per request
  @@index([approvalRequestId])
  @@index([assignedToId])
  @@index([status])
}

// ============================================
// Deep RBAC — Granular Permission System (Phase 3)
// ============================================

/**
 * RBACPermission — fine-grained, scoped permission grants.
 *
 * This extends the flat User.role system with:
 *   - Resource-level permissions (e.g., "payroll:view", "leave:approve")
 *   - Department scoping (HR Head of Engineering can only approve Engineering leaves)
 *   - Designation-based authority (Grade 7+ can approve expenses > 50k)
 *   - Time-bounded delegation (Acting GM while real GM is on leave)
 *
 * Permission format: "resource:action"
 *   - employees:view, employees:edit, employees:delete
 *   - payroll:view, payroll:process, payroll:approve
 *   - leave:view, leave:approve, leave:manage
 *   - expense:view, expense:approve, expense:manage
 *   - attendance:view, attendance:edit, attendance:manage
 *   - reports:view, reports:export
 *   - settings:manage
 *
 * Scope types:
 *   - "global" — applies to entire organization
 *   - "department" — only within specified department(s)
 *   - "branch" — only within specified branch(es)
 *   - "self" — only the user's own records
 */
model RBACPermission {
  id              String    @id @default(cuid())
  permission      String    // "payroll:process", "leave:approve", etc.
  scope           String    @default("global") // global, department, branch, self

  // Scoping filters (applied when scope is "department" or "branch")
  departmentIds   Json?     // ["dept_1", "dept_2"] — null means all
  branchIds       Json?     // ["branch_1"] — null means all
  designationMinGrade Int?  // Minimum designation grade required (for authority-based)

  // Time-bounded delegation
  validFrom       DateTime  @default(now())
  validUntil      DateTime? // Null = permanent
  isActive        Boolean   @default(true)

  // Granted to
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Organization
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([permission])
  @@index([isActive])
}

// ============================================
// RBAC v2 — Custom Roles, Permission Catalog, Assignments
// ============================================

/**
 * Role — a named set of permissions, either system-defined (5 built-in)
 * or tenant-defined (custom roles created by the org admin).
 *
 * System roles (isSystem=true): super_admin, admin, hr_admin, manager, employee.
 *   - Cannot be deleted.
 *   - Permissions can be EXTENDED but not REMOVED (to preserve invariants).
 *
 * Custom roles (isSystem=false): fully editable by org admin.
 *   - Subject to Plan.maxCustomRoles limit.
 *
 * Backward compatibility:
 *   User.role (String) remains the "primary role slug" for fast lookup.
 *   UserRoleAssignment is the source of truth for multi-role (future).
 *   For now, single-role assignment via UserRoleAssignment mirrors User.role.
 */
model Role {
  id              String   @id @default(cuid())
  name            String                          // "Branch Manager", "Finance Officer"
  slug            String                          // "branch_manager" — used in User.role
  description     String?
  isSystem        Boolean  @default(false)        // true for 5 built-in roles — cannot be deleted
  isDefault       Boolean  @default(false)        // true for the role assigned to new users
  dashboardConfig Json?                           // { widgets: [...] } — per-role dashboard
  color           String?                         // UI badge color
  sortOrder       Int      @default(0)            // display order in role list

  // Null = global system role; else tenant-scoped custom role
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, slug])                // (null, "admin") and (orgId, "branch_manager") both valid
  @@index([organizationId])
  @@index([isSystem])
}

/**
 * Permission — system-defined catalog of all available permissions.
 * Not tenant-editable (admin can't create new permission keys).
 * Seeded once during migration; new permissions added via future migrations.
 */
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique                     // "payroll:process", "leave:approve"
  module      String                              // "payroll", "leave", "attendance", ...
  action      String                              // "view", "create", "edit", "delete", "approve", "process"
  description String?
  isDangerous Boolean @default(false)             // true for destructive: delete, payroll:process

  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
}

/**
 * RolePermission — grants a Permission to a Role, with optional scope.
 *
 * Scope determines the data visibility for that permission:
 *   global     → entire organization
 *   department → only specified departmentIds
 *   branch     → only specified branchIds
 *   self       → only the user's own records
 *   team       → only direct reportees (for manager-style roles)
 */
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId    String
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  scope           String   @default("global")     // global, department, branch, self, team
  departmentIds   Json?                            // for scope=department: ["dept_1", "dept_2"]
  branchIds       Json?                            // for scope=branch: ["branch_1"]

  createdAt       DateTime @default(now())

  @@unique([roleId, permissionId, scope])
  @@index([roleId])
  @@index([permissionId])
}

/**
 * UserRoleAssignment — assigns a Role to a User.
 *
 * In v1 (current): each user has exactly ONE assignment mirroring User.role.
 *   This exists to enable the future multi-role feature without a second migration.
 *
 * In v2 (future): a user can have MULTIPLE assignments. Effective permissions
 *   = union of all assigned roles' permissions.
 *
 * expiresAt: optional time-bounded assignment (e.g., "acting manager for 2 weeks").
 */
model UserRoleAssignment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy      String?                           // User ID who assigned
  assignedAt      DateTime @default(now())
  expiresAt       DateTime?                         // optional time-bounded assignment

  @@unique([userId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Document Requests (Employee Self-Service)
// ============================================

model DocumentRequest {
  id            String    @id @default(cuid())
  type          String    // offer_letter, salary_certificate, experience_certificate, noc_letter, appointment_letter, increment_letter
  status        String    @default("pending") // pending, processing, ready, rejected
  documentUrl   String?   // Generated document URL or content
  processedAt   DateTime?
  processedBy   String?   // User ID of processor
  rejectionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employeeId String
  employee   Employee @relation("DocumentRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([organizationId])
}

// ============================================
// Biometric Device Management
// ============================================

model BiometricDevice {
  id              String    @id @default(cuid())
  name            String                          // "Main Gate", "Reception"
  serialNumber    String?                         // Device serial number
  model           String    @default("ZKTeco")    // ZKTeco, Suprema, HikVision, etc.
  ip              String                          // Device IP address
  port            Int       @default(4370)        // Communication port
  connectionType  String    @default("tcp")       // tcp, udp
  connectionMode  String    @default("sync_agent") // sync_agent, direct_cloud
  cloudProtocol   String?                         // adms, iclock, zkteco_push
  cloudStatus     String    @default("pending")   // pending, connected, warning, failed
  // Per-device shared secret for direct-cloud auth (HMAC).
  // When set, /iclock/* and /api/biometric-devices/adms-capture routes
  // require an X-PeopleFlow-Signature header = HMAC-SHA256(body, secret).
  // When null, the device is in "claim mode" — punches are captured to
  // BiometricCloudEvent but NOT ingested until the admin assigns a secret.
  cloudSecretHash String?                         // sha256(cloudSecret) — never store raw secret
  location        String?                         // Physical location description
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?                       // Last successful sync
  lastSyncStatus  String?                         // success, failed, partial
  lastSeenAt      DateTime?                       // Last direct-cloud heartbeat/request
  firmwareVersion String?                         // Reported by device if available
  timezone        String    @default("Asia/Dhaka")
  setupNotes      String?
  syncInterval    Int       @default(15)          // Auto-sync every N minutes

  // ── Device Health Monitoring ──
  lastPingAt          DateTime?                   // Last successful heartbeat
  isOnline            Boolean   @default(false)   // Current reachability status
  consecutiveFailures Int       @default(0)       // Failed sync/ping streak
  alertSentAt         DateTime?                   // Last time an offline alert was sent
  maxRetries          Int       @default(5)       // Max retry attempts before DLQ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // ── Sync Agent Link ──
  // Links this device card to the SyncApiKey whose agent pushes data for it.
  // The agent's push authenticates the API key; we then use this link to
  // resolve the device card without relying on ip+port matching (which is
  // fragile for private-LAN devices whose ip is rewritten to adms:SERIAL
  // when connectionMode = direct_cloud).
  syncApiKeyId   String?
  syncApiKey     SyncApiKey? @relation(fields: [syncApiKeyId], references: [id], onDelete: SetNull)

  syncLogs    DeviceSyncLog[]
  healthLogs  DeviceHealthLog[]
  cloudEvents BiometricCloudEvent[]

  @@unique([organizationId, ip, port])
  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([isActive])
  @@index([isOnline])
  @@index([connectionMode])
  @@index([cloudStatus])
  @@index([lastSeenAt])
  @@index([syncApiKeyId])
}

model BiometricCloudEvent {
  id              String   @id @default(cuid())
  serialNumber    String?
  eventType       String   // registry, cdata, getrequest, devicecmd, unknown
  method          String
  path            String
  query           Json     @default("{}")
  headers         Json     @default("{}")
  body            String?
  status          String   @default("captured") // captured, processed, partial, unknown_device, failed
  recordsReceived Int      @default(0)
  recordsSynced   Int      @default(0)
  recordsSkipped  Int      @default(0)
  unmappedUserIds String[] @default([])
  errorMessage    String?
  remoteIp        String?
  createdAt       DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  deviceId String?
  device   BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([serialNumber])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@index([deviceId])
}

model DeviceSyncLog {
  id             String   @id @default(cuid())
  status         String                         // success, failed, partial
  recordsSynced  Int      @default(0)
  recordsSkipped Int      @default(0)
  errorMessage   String?
  syncDuration   Int?                           // Duration in milliseconds
  syncedAt       DateTime @default(now())

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([syncedAt])
}

// Health check ping history — tracks device reachability over time
model DeviceHealthLog {
  id        String   @id @default(cuid())
  status    String   // online, offline, timeout, connection_refused
  latencyMs Int?     // Round-trip time in ms (null if offline)
  error     String?  // Error message if offline
  checkedAt DateTime @default(now())

  deviceId String
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([checkedAt])
}

// ============================================
// Sync Agent API Keys — Secure Cloud Bridge
// ============================================

model SyncApiKey {
  id              String    @id @default(cuid())
  key             String    @unique             // sha256 hashed API key (pf_sync_xxx)
  keyPrefix       String                        // First 8 chars for display (pf_sync_)
  name            String                        // "Main Office Agent", "Branch-2 Agent"
  isActive        Boolean   @default(true)
  lastHeartbeat   DateTime?                     // Last heartbeat from agent
  lastSyncAt      DateTime?                     // Last successful data push
  agentVersion    String?                       // Agent software version
  agentIp         String?                       // Last known IP of the agent
  syncCount       Int       @default(0)         // Total successful syncs
  totalRecords    Int       @default(0)         // Total attendance records pushed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?                     // Soft revoke

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Back-relation to devices that use this key
  biometricDevices BiometricDevice[]

  @@index([organizationId])
  @@index([key])
}

// ============================================
// SALES: Lead Capture Pipeline
// ============================================

model SalesLead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  companyName String
  companySize String   // "1-50", "51-200", "201-500", "500+"
  sector      String   // "rmg", "corporate", "ngo", "other"
  message     String?
  source      String   @default("website") // "website", "pricing_page", "hero_cta", "referral"
  status      String   @default("new") // "new", "contacted", "qualified", "demo_scheduled", "converted", "lost"
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}
