# ═══════════════════════════════════════════════════════════════
# PeopleFlow HRMS — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# CRITICAL: Never commit .env to version control.
# Validation: All variables are validated at boot via Zod.
# Missing required variables will crash the app with a clear error.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────────────────
# For development: use peopleflow (superuser) for convenience
# For production: use peopleflow_app (NOSUPERUSER) for RLS enforcement
DATABASE_URL="postgresql://peopleflow:CHANGE_ME_LOCAL_ONLY@localhost:5432/peopleflow"

# RLS App Role Password (production only)
# The peopleflow_app role enforces Row Level Security.
# Set this in production — the migrate container will set the password.
PF_APP_DB_PASSWORD=""

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME_LOCAL_ONLY@localhost:6379"

# ── NextAuth ───────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Platform Admin JWT ─────────────────────────────────────────
# CRITICAL: Used for platform admin authentication (separate from tenant auth).
# In production, if this is not set AND NEXTAUTH_SECRET is also missing,
# the server will refuse to start (fail-fast security).
# Generate with: openssl rand -base64 32
PLATFORM_JWT_SECRET=""

# ── Encryption Key (for sensitive credentials at rest) ─────────
# Used by src/lib/crypto.ts to encrypt/decrypt bKash, Nagad, and bank
# API credentials stored in Organization.settings.
# MUST be 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# CRITICAL: Never change this after data is encrypted — old data becomes undecryptable.
# Encryption (32 bytes = 64 hex chars) — REQUIRED in production
ENCRYPTION_KEY=""

# ── Public URLs ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe Billing ─────────────────────────────────────────────
# Use Stripe test keys locally/staging. Use live keys only in production.
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Redis ─────────────────────────────────────────────────────
# Password must match the --requirepass in docker-compose.yml
REDIS_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# ── Docker Compose Local Database Password ────────────────────
# Required by docker-compose.yml; keep unique per environment.
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# ── Sentry Error Tracking ─────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN is inlined at build time — set BEFORE `next build`.
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@peopleflow.app"

# ── File Storage ──────────────────────────────────────────────
# Provider: "local", "s3", or "r2"
# Storage (S3/R2)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# S3_* are the canonical names (also consumed by docker-compose.yml).
# Legacy STORAGE_S3_* names are read as a fallback in src/lib/storage.ts.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
# Legacy aliases (optional — leave blank if using S3_* above)
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""
# STORAGE_S3_ENDPOINT=""
# STORAGE_PUBLIC_URL=""

# ── CRON Authentication ───────────────────────────────────────
# Cron authentication — REQUIRED in production (min 16 characters).
# Generate with: openssl rand -hex 16
# Verified at boot by src/lib/env.ts; missing/short values crash the app
# in production (see CRON_SECRET refine in env schema).
CRON_SECRET=""

# ── Platform Admin Seeder ─────────────────────────────────────
# Optional. If both are blank, no platform admin is seeded.
# If either is set, both must be set and password must be strong.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# ── Logging ───────────────────────────────────────────────────
# Log level: fatal, error, warn, info, debug, trace
# Defaults to "info" if unset (see docker-compose.yml LOG_LEVEL default).
LOG_LEVEL="info"

# ── Web Push (VAPID) ──────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# The public key is exposed to the browser; the private key is server-only.
# When unset, push notifications are silently disabled (see src/lib/web-push.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Health alerting (comma-separated emails, optional Slack/Discord webhook) ──
# When the health-ping cron finds DB/Redis down, it emails these recipients
# and (if set) POSTs a Slack/Discord-formatted JSON to the webhook.
# A 30-min in-memory cooldown prevents alert spam.
HEALTH_ALERT_EMAILS=""
HEALTH_ALERT_WEBHOOK=""
