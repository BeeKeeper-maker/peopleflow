# ═══════════════════════════════════════════════════════════════
# PeopleFlow HRMS — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# CRITICAL: Never commit .env to version control.
# Validation: All variables are validated at boot via Zod.
# Missing required variables will crash the app with a clear error.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL="postgresql://peopleflow:CHANGE_ME_LOCAL_ONLY@localhost:5432/peopleflow"

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME_LOCAL_ONLY@localhost:6379"

# ── NextAuth ───────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Platform Admin JWT ─────────────────────────────────────────
# CRITICAL: Used for platform admin authentication (separate from tenant auth).
# In production, if this is not set AND NEXTAUTH_SECRET is also missing,
# the server will refuse to start (fail-fast security).
# Generate with: openssl rand -base64 32
PLATFORM_JWT_SECRET=""

# ── Public URLs ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe Billing ─────────────────────────────────────────────
# Use Stripe test keys locally/staging. Use live keys only in production.
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Redis ─────────────────────────────────────────────────────
# Password must match the --requirepass in docker-compose.yml
REDIS_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# ── Docker Compose Local Database Password ────────────────────
# Required by docker-compose.yml; keep unique per environment.
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# ── Sentry Error Tracking ─────────────────────────────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@peopleflow.app"

# ── File Storage ──────────────────────────────────────────────
# Provider: "local", "s3", or "r2"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""
# STORAGE_S3_ENDPOINT=""
# STORAGE_PUBLIC_URL=""

# ── CRON Authentication ───────────────────────────────────────
# Minimum 16 characters. Generate with: openssl rand -hex 16
CRON_SECRET=""

# ── Platform Admin Seeder ─────────────────────────────────────
# Optional. If both are blank, no platform admin is seeded.
# If either is set, both must be set and password must be strong.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# ── Logging ───────────────────────────────────────────────────
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=""
